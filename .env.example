# ====================================================================
# KathiravanMart - Environment Variables Template
# Copy this file to .env and configure your values.
# NEVER commit the actual .env file with secrets to GitHub!
# ====================================================================

# Application
APP_NAME=KathiravanMart
APP_ENV=production
APP_PORT=8080
APP_BASE_URL=http://localhost:8080/kathiravanmart

# Database Configuration (H2 Server Mode or Embedded Mode)
# Server mode URL: jdbc:h2:tcp://localhost:9092/./data/kathiravanmart
# Embedded auto-server mode URL: jdbc:h2:./data/kathiravanmart;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE
DB_URL=jdbc:h2:./data/kathiravanmart;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE
DB_USER=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# AI Chatbot Configuration
# Provider options: "mock" (no API key needed) or "gemini" (Gemini LLM API)
AI_CHATBOT_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent

# Session Settings
SESSION_TIMEOUT_MINUTES=30

<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>KathiravanMart</display-name>

    <!-- 1. Global Context Listener for Connection Pool & Database Initialization -->
    <listener>
        <listener-class>com.kathiravan.kathiravanmart.listener.AppContextListener</listener-class>
    </listener>

    <!-- 2. Filters -->
    <!-- Filter A: Request ID Generation & SLF4J MDC Binding -->
    <filter>
        <filter-name>RequestIdFilter</filter-name>
        <filter-class>com.kathiravan.kathiravanmart.filter.RequestIdFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RequestIdFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Filter B: UTF-8 Character Encoding -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.kathiravan.kathiravanmart.filter.EncodingFilter</filter-class>
        <init-param>
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Filter C: CORS Filter for JSON Endpoints -->
    <filter>
        <filter-name>CorsFilter</filter-name>
        <filter-class>com.kathiravan.kathiravanmart.filter.CorsFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CorsFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <!-- Filter D: Authentication & Authorization Filter -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.kathiravan.kathiravanmart.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/cart/*</url-pattern>
        <url-pattern>/checkout/*</url-pattern>
        <url-pattern>/orders/*</url-pattern>
        <url-pattern>/wishlist/*</url-pattern>
        <url-pattern>/seller/*</url-pattern>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/api/v1/cart/*</url-pattern>
        <url-pattern>/api/v1/orders/*</url-pattern>
        <url-pattern>/api/v1/reviews/*</url-pattern>
        <url-pattern>/api/v1/wishlist/*</url-pattern>
        <url-pattern>/api/v1/seller/*</url-pattern>
        <url-pattern>/api/v1/admin/*</url-pattern>
    </filter-mapping>

    <!-- 3. Servlets -->
    <!-- Auth Servlet -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.kathiravan.kathiravanmart.controller.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/auth/*</url-pattern>
        <url-pattern>/login</url-pattern>
        <url-pattern>/register</url-pattern>
        <url-pattern>/logout</url-pattern>
        <url-pattern>/api/v1/auth/*</url-pattern>
    </servlet-mapping>

    <!-- Product Servlet -->
    <servlet>
        <servlet-name>ProductServlet</servlet-name>
        <servlet-class>com.kathiravan.kathiravanmart.controller.ProductServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProductServlet</servlet-name>
        <url-pattern>/products/*</url-pattern>
        <url-pattern>/api/v1/products/*</url-pattern>
    </servlet-mapping>

    <!-- Cart Servlet -->
    <servlet>
        <servlet-name>CartServlet</servlet-name>
        <servlet-class>com.kathiravan.kathiravanmart.controller.CartServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CartServlet</servlet-name>
        <url-pattern>/cart/*</url-pattern>
        <url-pattern>/api/v1/cart/*</url-pattern>
    </servlet-mapping>

    <!-- Order Servlet -->
    <servlet>
        <servlet-name>OrderServlet</servlet-name>
        <servlet-class>com.kathiravan.kathiravanmart.controller.OrderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OrderServlet</servlet-name>
        <url-pattern>/orders/*</url-pattern>
        <url-pattern>/checkout/*</url-pattern>
        <url-pattern>/api/v1/orders/*</url-pattern>
    </servlet-mapping>

    <!-- Review Servlet -->
    <servlet>
        <servlet-name>ReviewServlet</servlet-name>
        <servlet-class>com.kathiravan.kathiravanmart.controller.ReviewServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReviewServlet</servlet-name>
        <url-pattern>/reviews/*</url-pattern>
        <url-pattern>/api/v1/reviews/*</url-pattern>
    </servlet-mapping>

    <!-- Wishlist Servlet (Feature O1) -->
    <servlet>
        <servlet-name>WishlistServlet</servlet-name>
        <servlet-class>com.kathiravan.kathiravanmart.controller.WishlistServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>WishlistServlet</servlet-name>
        <url-pattern>/wishlist/*</url-pattern>
        <url-pattern>/api/v1/wishlist/*</url-pattern>
    </servlet-mapping>

    <!-- Seller Dashboard Servlet -->
    <servlet>
        <servlet-name>SellerServlet</servlet-name>
        <servlet-class>com.kathiravan.kathiravanmart.controller.SellerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SellerServlet</servlet-name>
        <url-pattern>/seller/*</url-pattern>
        <url-pattern>/api/v1/seller/*</url-pattern>
    </servlet-mapping>

    <!-- Admin Servlet -->
    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>com.kathiravan.kathiravanmart.controller.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/api/v1/admin/*</url-pattern>
    </servlet-mapping>

    <!-- AI Chatbot Servlet (Feature O4 / Phase 3) -->
    <servlet>
        <servlet-name>ChatServlet</servlet-name>
        <servlet-class>com.kathiravan.kathiravanmart.controller.ChatServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ChatServlet</servlet-name>
        <url-pattern>/api/v1/chat/*</url-pattern>
    </servlet-mapping>

    <!-- Health Check Servlet (Section 18) -->
    <servlet>
        <servlet-name>HealthServlet</servlet-name>
        <servlet-class>com.kathiravan.kathiravanmart.controller.HealthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HealthServlet</servlet-name>
        <url-pattern>/api/v1/health</url-pattern>
    </servlet-mapping>

    <!-- Session Configuration: 30 Minutes Explicit Timeout -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Welcome File -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Custom Error Pages (Prevent Stack Trace Exposure - Section 9 & 10) -->
    <error-page>
        <error-code>400</error-code>
        <location>/WEB-INF/error/400.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/error/403.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/error/500.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/error/500.jsp</location>
    </error-page>

</web-app>
